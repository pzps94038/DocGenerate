{
  "openapi": "3.0.1",
  "info": {
    "title": "大題庫試卷內容輸出 API (以 出題高手 發想)",
    "description": "以出題高手的使用需求，作為 API 規劃的起點，情境為每個學期開始前，匯入新題目的流程。<br>API 的路徑帶版本號，保留未來更新 API 格式時，同時相容新舊格式的彈性。<h2>流程概述</h2><h3>題目匯入 (服務端，如出題高手的角度來看)</h3><ol><li>指定學年度，抓回完整的課次資料 (章節名稱，節點之間的關聯）</li><li>同步所有終端節點 (leaf node) 的題目資訊</li><li>取得 (服務自己題庫) 缺少或需要更新題目檔案(Word, HTML, mp3)</li></ol><h3>錯題回報 + 更新</h3><ol><li>將用戶反應的狀況，回報給到大題庫作記錄，並標注該題為「待處理」</li><li>定時檢查「待處理」的題目，遇到有新版本或被下架，才將標注移除</li></ol>",
    "version": "v0.0.2"
  },
  "paths": {
    "/api/QuestionGet/CourseTree": {
      "get": {
        "tags": [
          "QuestionGet"
        ],
        "summary": "指定學期，取得完整的課次資料",
        "description": "取得事前在後台建置完成的指定學期的課次資料，得到章節名稱等相關資訊（不包含題目）",
        "parameters": [
          {
            "name": "semester",
            "in": "query",
            "description": "學期代碼",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "schoolLevel",
            "in": "query",
            "description": "學級 (E: 國小, J: 國中, H: 高中)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CourseTreeVModelListJsonDataResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/QuestionGet/QuestionList": {
      "get": {
        "tags": [
          "QuestionGet"
        ],
        "summary": "指定課次範圍代碼，取得對應題目資訊",
        "description": "取得指定課次代碼下，關連到的題目資訊。\r\n\r\n只關聯到完整對應的項目，換言之，不回應到子節點下的題目。",
        "parameters": [
          {
            "name": "courseScopeId",
            "in": "query",
            "description": "課次代碼",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuestionListVModelListJsonDataResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/QuestionGet/Question": {
      "get": {
        "tags": [
          "QuestionGet"
        ],
        "summary": "指定題目 ID ，取得關聯的題目資料(metadata ，不含檔案)",
        "description": "取得指定題目 ID ，關連到的題目資訊。 主要為了錯題回報之後，重新取得最新版本題目內容使用。\r\n\r\n為了錯題回報後，若決定「下架」處理，仍有管道可以得知其狀態。因此在回傳值增加一個 Offline 屬性。",
        "parameters": [
          {
            "name": "QuestionId",
            "in": "query",
            "description": "題目 ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuestionVModelJsonDataResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/QuestionGet/QuestionFile": {
      "get": {
        "tags": [
          "QuestionGet"
        ],
        "summary": "指定題目 ID ，取得該題目壓縮檔",
        "description": "透過題目 ID ，取得題目相關的檔案。必須包含 HTML 以及 Word 檔案。而視題型需要，也要納入聲音檔案。",
        "parameters": [
          {
            "name": "questionId",
            "in": "query",
            "description": "題目 ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Base64DataJsonDataResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/QuestionGet/QuestionIssue": {
      "post": {
        "tags": [
          "QuestionGet"
        ],
        "summary": "指定題目 ID ，回報題目的問題",
        "description": "回傳使用現場遇到的問題",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuestionIssueVModel"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/QuestionIssueVModel"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/QuestionIssueVModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuestionIssueVModelJsonDataResponse"
                }
              }
            }
          }
        }
      }
    }
  },
